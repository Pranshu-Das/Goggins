# Copy this file to .env and fill in your own values. Never commit .env itself.

PORT=5000

# No MongoDB install needed by default: leave MONGO_URI blank/commented out
# and the app will automatically start an embedded MongoDB for you, storing
# data in backend/.data/mongodb.
#
# If you'd rather use a real MongoDB later (local install or Atlas),
# uncomment one of these and fill it in:
# MONGO_URI=mongodb://127.0.0.1:27017/discipline-quest
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/discipline-quest

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173
